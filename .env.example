# Server-only Supabase URL. Do not prefix with VITE_.
SUPABASE_URL="https://your-project.supabase.co"

# Supabase Publishable key (sb_publishable_...) or legacy anon key.
# Never use a service_role / sb_secret key here.
SUPABASE_ANON_KEY="sb_publishable_your_key_here"

# Unique random secret (at least 32 characters) for encrypted HttpOnly sessions.
AICRATIVE_SESSION_SECRET="replace-with-a-long-random-secret"

# Server-only shared studio password.
AICRATIVE_ACCESS_PASSWORD="replace-with-a-long-random-password"
