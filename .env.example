# Public Supabase project URL (safe to expose in browser)
VITE_SUPABASE_URL="https://your-project.supabase.co"

# Supabase Publishable key (sb_publishable_...) or legacy anon key.
# NEVER use a service_role or sb_secret key in a VITE_ variable.
VITE_SUPABASE_ANON_KEY="sb_publishable_your_key_here"

# Server-only shared studio password (configure in Vercel; never prefix with VITE_).
AICRATIVE_ACCESS_PASSWORD="replace-with-a-long-random-password"
