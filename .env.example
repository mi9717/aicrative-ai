# GEMINI_API_KEY: Required for Gemini AI API calls.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
APP_URL="MY_APP_URL"

# APP_ACCESS_PASSWORD: Password required to access AICRATIVE Studio.
# Configured in Supabase Secrets or backend environment.
APP_ACCESS_PASSWORD="MY_APP_ACCESS_PASSWORD"

# SUPABASE_URL: Supabase Edge Function URL for AICRATIVE AI backend
SUPABASE_URL="https://your-project.supabase.co/functions/v1/aicrative-ai"

# SUPABASE_KEY: Supabase publishable key used only by the server-side proxy
SUPABASE_KEY="sb_publishable_your_key_here"
