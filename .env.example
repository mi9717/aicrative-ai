# Server-only Supabase project URL. Never prefix server secrets with VITE_.
SUPABASE_URL="https://your-project.supabase.co"

# Server-only legacy Supabase service_role JWT key.
# Required for the shared workspace API. NEVER expose this in browser code,
# VITE_ variables, GitHub, or chat. Store only in Vercel server Environment Variables.
SUPABASE_SERVICE_ROLE_KEY="replace-with-your-service-role-key"

# Strong random secret (at least 32 characters) used to sign the shared access cookie.
AICRATIVE_SESSION_SECRET="replace-with-a-long-random-secret"

# Shared password entered by all AICRATIVE workspace users.
AICRATIVE_ACCESS_PASSWORD="replace-with-a-long-random-password"
